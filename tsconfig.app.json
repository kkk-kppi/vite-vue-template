{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/**/**/*.vue",
    // 
    "/env/*.ts",
    // 包含auto-imports.d.ts，让ts能知道有声明过，自动引入不报错
    "./auto-imports.d.ts",
    // 
    "./components.d.ts"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "hooks/*": [
        "./src/common/hooks/*"
      ]
    }
  }
}